:root {
    --primary-color: #ff9900;
    /* AWS Orange */
    --secondary-color: #232f3e;
    /* AWS Dark Blue */
    --accent-color: #0073bb;
    --text-white: #ffffff;
    --text-gray: #f2f3f3;
    --transition-speed: 0.8s;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: radial-gradient(circle at center, #2c3e50, #000000);
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--text-white);
    overflow: hidden;
}

.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    perspective: 1200px;
    /* Essential for 3D */
}

.flip-card {
    width: 380px;
    height: 240px;
    cursor: pointer;
}

.flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform var(--transition-speed) cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border-radius: 20px;
}

/* Hover and active states */
.flip-card:hover .flip-card-inner,
.flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
}

.flip-card-front,
.flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    /* Safari */
    backface-visibility: hidden;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Front Side Styling */
.flip-card-front {
    background: linear-gradient(135deg, var(--secondary-color) 0%, #1a222d 100%);
    overflow: hidden;
}

.card-content {
    z-index: 2;
}

.aws-logo {
    color: var(--primary-color);
    margin-bottom: 15px;
    filter: drop-shadow(0 0 10px rgba(255, 153, 0, 0.3));
}

#title-text {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 5px;
    background: linear-gradient(to right, #fff, #ff9900);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitle {
    font-size: 1rem;
    color: #a0acba;
    font-weight: 400;
    margin-bottom: 20px;
}

.developer-tag {
    font-size: 0.75rem;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    opacity: 0.8;
}

.shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0) 100%);
    transform: skewX(-25deg);
    transition: 0.75s;
    pointer-events: none;
}

.flip-card:hover .shine {
    left: 150%;
}

/* Back Side Styling */
.flip-card-back {
    background: linear-gradient(135deg, #161c24 0%, var(--secondary-color) 100%);
    color: white;
    transform: rotateY(180deg);
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(46, 204, 113, 0.1);
    padding: 4px 12px;
    border-radius: 50px;
    margin-bottom: 20px;
    border: 1px solid rgba(46, 204, 113, 0.2);
}

.dot {
    width: 8px;
    height: 8px;
    background-color: #2ecc71;
    border-radius: 50%;
}

.pulse {
    animation: pulse-animation 2s infinite;
}

@keyframes pulse-animation {
    0% {
        box-shadow: 0 0 0 0px rgba(46, 204, 113, 0.7);
    }

    100% {
        box-shadow: 0 0 0 10px rgba(46, 204, 113, 0);
    }
}

.status-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2ecc71;
    text-transform: uppercase;
}

.flip-card-back h2 {
    font-size: 1.5rem;
    margin-bottom: 15px;
    color: var(--primary-color);
}

.deployment-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #cbd5e0;
}

.specs {
    margin-top: 20px;
    display: flex;
    gap: 15px;
    font-size: 0.8rem;
    opacity: 0.6;
}

.hint {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: opacity 0.3s;
}

.flip-card:hover+.hint {
    opacity: 0.7;
}

/* Responsive adjustments */
@media (max-width: 480px) {
    .flip-card {
        width: 320px;
        height: 220px;
    }

    #title-text {
        font-size: 2rem;
    }
}
